NODE_ENV=development
TZ=America/Sao_Paulo
SDR_PUBLIC_FLAG=false
SDR_ALLOWLIST_MODE=true
SDR_OWNER_ALLOWLIST=5511999999999
SDR_WORKSPACE_ROOT=/opt/dwlabs-sdr
N8N_BASE_URL=http://127.0.0.1:5678
N8N_SDR_HEADER_AUTH_ID=DWLABS_SDR_HEADER_AUTH
N8N_SDR_HEADER_AUTH_NAME=DWLabs SDR Header Auth
N8N_SDR_SHARED_TOKEN=__PLACEHOLDER_ONLY__
N8N_WORKFLOW_PG_CREDENTIAL_ID=DWLABS_SDR_POSTGRES_ID
N8N_WORKFLOW_PG_CREDENTIAL_NAME=DWLABS_SDR_POSTGRES
N8N_WORKFLOW_GOOGLE_CALENDAR_CREDENTIAL_ID=DWLABS_SDR_GOOGLE_CALENDAR_ID
N8N_WORKFLOW_GOOGLE_CALENDAR_CREDENTIAL_NAME=DWLABS_SDR_GOOGLE_CALENDAR
N8N_WORKFLOW_GOOGLE_SHEETS_CREDENTIAL_ID=DWLABS_SDR_GOOGLE_SHEETS_ID
N8N_WORKFLOW_GOOGLE_SHEETS_CREDENTIAL_NAME=DWLABS_SDR_GOOGLE_SHEETS
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dwlabs_sdr
POSTGRES_USER=dwlabs_sdr_app
POSTGRES_PASSWORD=__PLACEHOLDER_ONLY__
POSTGRES_OWNER_USER=dwlabs_sdr_owner
OPENCLAW_PLUGIN_BASE_URL=http://127.0.0.1:5678/webhook
OPENCLAW_PLUGIN_TIMEOUT_MS=8000
N8N_CONTAINER=n8n
N8N_POSTGRES_CONTAINER=n8n-postgres
OPENCLAW_CONTAINER=openclaw-openclaw-gateway-1
REMOTE_DEPLOY_ROOT=/home/dominique/docker/dwlabs-sdr
OPENCLAW_HOST_ROOT=/home/dominique/docker/openclaw
N8N_PROJECT_ID=__PLACEHOLDER_ONLY__
SDR_BIND_WHATSAPP=false
SDR_WHATSAPP_BINDING=whatsapp
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
AUDIO_PROVIDER=disabled
AUDIO_PROVIDER_API_KEY=__PLACEHOLDER_ONLY__
NOTIFICATION_MODE=mock
NOTIFICATION_WEBHOOK_URL=https://example.invalid/internal-sales
