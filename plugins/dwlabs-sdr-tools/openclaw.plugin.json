{
  "id": "dwlabs-sdr-tools",
  "name": "DWLabs SDR Tools",
  "description": "Ferramentas tipadas e allowlisted do SDR comercial da DWLabs.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "bearerToken": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 43
          },
          {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "source",
                  "provider",
                  "id"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "env"
                  },
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "source",
                  "provider",
                  "id"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "file"
                  },
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "source",
                  "provider",
                  "id"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "exec"
                  },
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000
      },
      "allowlist": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "bearerToken",
          "expected": "string"
        }
      ]
    }
  },
  "contracts": {
    "tools": [
      "buscar_servicos",
      "buscar_servico",
      "buscar_precos",
      "buscar_portfolio",
      "salvar_lead",
      "atualizar_lead",
      "buscar_lead",
      "buscar_cliente",
      "registrar_interacao",
      "calcular_score",
      "verificar_agenda",
      "agendar_reuniao",
      "reagendar_reuniao",
      "cancelar_reuniao",
      "criar_resumo",
      "notificar_vendedor",
      "agendar_followup",
      "cancelar_followup",
      "buscar_conhecimento",
      "transcrever_audio",
      "transferir_humano",
      "sincronizar_sheets"
    ]
  }
}
