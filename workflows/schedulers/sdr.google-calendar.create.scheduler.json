        "language": "javaScript",
        "jsCode": "if (!$json.job_id) throw new Error('CALENDAR_JOB_ID_MISSING'); return [{ json: { job_id: String($json.job_id), result_base64: Buffer.from(JSON.stringify($json), 'utf8').toString('base64') } }];"
