        "query": "SELECT ops.complete_calendar_integration($1::uuid, convert_from(decode($2, 'base64'), 'UTF8')::jsonb) AS completed;",
        "options": {
          "queryReplacement": "={{[$json.job_id, $json.result_base64]}}"
