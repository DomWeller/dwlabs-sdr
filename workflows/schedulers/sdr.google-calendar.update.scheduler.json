        "query": "SELECT * FROM ops.claim_calendar_integration('n8n-calendar-update', 'update');",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "DWLABS_SDR_POSTGRES_ID",
          "name": "DWLABS_SDR_POSTGRES"
