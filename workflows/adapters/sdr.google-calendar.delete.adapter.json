{
  "id": "d8234444-2471-e432-acfc-08d148e78cb4",
  "name": "sdr.google-calendar.delete.adapter",
  "nodes": [
    {
      "id": "37d7f6d3-28c7-f5da-23a5-7aa788fa43a2",
      "name": "Execute Adapter",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        }
      }
    },
    {
      "id": "1e629de3-b8fa-b622-0d2d-9f8643db77a4",
      "name": "Validate Adapter Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const input = $json ?? {};\nconst required = [\"calendar_id\",\"event_id\",\"authorized\"];\nconst missing = required.filter((field) => input[field] === undefined || input[field] === null || input[field] === '');\nif (missing.length) throw new Error(`ADAPTER_INPUT_INVALID:${missing.join(',')}`);\nif (input.authorized !== true) throw new Error('ADAPTER_AUTH_REQUIRED');\nif (input.start_at && input.end_at && new Date(input.end_at) <= new Date(input.start_at)) throw new Error('ADAPTER_WINDOW_INVALID');\nreturn [{ json: input }];"
      }
    },
    {
      "id": "9e3cb597-0d7d-e01c-339b-7495a3507889",
      "name": "Google Operation",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        800,
        300
      ],
      "parameters": {
        "resource": "event",
        "operation": "delete",
        "calendar": {
          "mode": "id",
          "value": "={{ $json.calendar_id }}"
        },
        "eventId": "={{ $json.event_id }}",
        "options": {
          "sendUpdates": "all"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "DWLABS_SDR_GOOGLE_CALENDAR_ID",
          "name": "DWLABS_SDR_GOOGLE_CALENDAR"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": false
    },
    {
      "id": "1e487494-aefa-a8eb-f7ed-8bd2dbacd65c",
      "name": "Sanitize Adapter Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const request = $('Validate Adapter Input').item.json; return [{ json: { ok: true, job_id: request.job_id || null, meeting_id: request.meeting_id || null, external_event_id: request.event_id || null, deleted: true, status: 'deleted' } }];"
      }
    }
  ],
  "connections": {
    "Execute Adapter": {
      "main": [
        [
          {
            "node": "Validate Adapter Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Adapter Input": {
      "main": [
        [
          {
            "node": "Google Operation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Operation": {
      "main": [
        [
          {
            "node": "Sanitize Adapter Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "pinData": {},
