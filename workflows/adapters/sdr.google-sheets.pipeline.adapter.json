      "id": "36e6d692-6945-06b9-0b55-1fffb6511964",
      "name": "Validate Adapter Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const input = $json ?? {};\nconst required = [\"document_id\",\"sheet_name\",\"row\",\"authorized\"];\nconst missing = required.filter((field) => input[field] === undefined || input[field] === null || input[field] === '');\nif (missing.length) throw new Error(`ADAPTER_INPUT_INVALID:${missing.join(',')}`);\nif (input.authorized !== true) throw new Error('ADAPTER_AUTH_REQUIRED');\nif (input.start_at && input.end_at && new Date(input.end_at) <= new Date(input.start_at)) throw new Error('ADAPTER_WINDOW_INVALID');\nif (!input.row || typeof input.row !== 'object' || Array.isArray(input.row) || !input.row.lead_id) throw new Error('SHEETS_ROW_INVALID');\nreturn [{ json: { document_id: input.document_id, sheet_name: input.sheet_name, ...input.row } }];"
      }
    },
