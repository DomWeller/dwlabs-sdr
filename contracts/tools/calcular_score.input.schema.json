{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram",
        "site",
        "test"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact_name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "company_name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": []
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "lead_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "fragments": {
          "type": "array",
          "description": "Mensagens segmentadas ja recebidas",
          "items": {
            "type": "string"
          }
        },
        "locale": {
          "type": "string",
          "default": "pt-BR"
        }
      },
      "required": []
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead_id": {
          "type": "string"
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "has_defined_offer": {
              "type": "boolean"
            },
            "urgency_level": {
              "type": "string"
            },
            "budget_signal": {
              "type": "string"
            },
            "authority_level": {
              "type": "string"
            },
            "inbound_intent": {
              "type": "string"
            },
            "existing_channels": {
              "type": "string"
            },
            "wants_meeting": {
              "type": "boolean"
            },
            "asks_for_proposal": {
              "type": "boolean"
            }
          },
          "required": []
        }
      },
      "required": []
    }
  },
  "required": [
    "request_id",
    "idempotency_key",
    "channel",
    "actor",
    "context",
    "payload"
  ]
}
