{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sync_job_id": {
              "type": "string"
            },
            "integration_status": {
              "type": "string"
            }
          },
          "required": [
            "sync_job_id",
            "integration_status"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "redactions_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "correlation_id",
        "redactions_applied"
      ]
    }
  },
  "required": [
    "ok",
    "data",
    "error",
    "audit"
  ]
}
