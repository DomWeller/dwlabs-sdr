{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram",
        "site",
        "test"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact_name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "company_name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": []
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "lead_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "fragments": {
          "type": "array",
          "description": "Mensagens segmentadas ja recebidas",
          "items": {
            "type": "string"
          }
        },
        "locale": {
          "type": "string",
          "default": "pt-BR"
        }
      },
      "required": []
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "interaction_type": {
          "type": "string",
          "enum": [
            "inbound",
            "outbound",
            "note",
            "system",
            "handoff",
            "followup"
          ]
        },
        "content": {
          "type": "string"
        },
        "source_message_id": {
          "type": "string"
        }
      },
      "required": [
        "interaction_type",
        "content"
      ]
    }
  },
  "required": [
    "request_id",
    "idempotency_key",
    "channel",
    "actor",
    "context",
    "payload"
  ]
}
