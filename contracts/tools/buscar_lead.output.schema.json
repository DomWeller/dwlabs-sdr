{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lead": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lead_id": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "score": {
                  "type": "integer"
                },
                "temperature_band": {
                  "type": "string"
                },
                "needs": {
                  "type": "array",
                  "description": "Necessidades resumidas",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": []
            }
          },
          "required": []
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
