{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "services": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "service_id": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "pricing_mode": {
                    "type": "string"
                  },
                  "upsells": {
                    "type": "array",
                    "description": "Upsells possiveis",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "service_id",
                  "slug",
                  "name",
                  "summary",
                  "pricing_mode",
                  "upsells"
                ]
              }
            }
          },
          "required": []
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "redactions_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "correlation_id",
        "redactions_applied"
      ]
    }
  },
  "required": [
    "ok",
    "data",
    "error",
    "audit"
  ]
}
